---
import Badge from '../ui/Badge.astro';

const skillGroups = [
  {
    label: "Core Security",
    items: ["Web Application Pentesting", "Bug Bounty Hunting", "Network Security", "Red Teaming"]
  },
  {
    label: "Languages",
    items: ["Python", "Bash", "Go"]
  },
  {
    label: "Tools",
    items: ["Burp Suite", "Nuclei", "SQLMap", "Wireshark"]
  },
  {
    label: "Specialized",
    items: ["Subdomain Enumeration", "Social Engineering", "WiFi Pentesting", "IoT Security"]
  }
];

const experience = [
  {
    role: "Bug Hunter",
    company: "NCIIPC, Max Healthcare, Nykaa",
    period: "2025 — Present",
    desc: "Identified and responsibly disclosed vulnerabilities in Indian government and private sector platforms."
  }
];
---

<section id="about" class="py-24 px-6 reveal">
  <div class="max-w-6xl mx-auto">
    <div class="flex items-center gap-3 mb-16">
      <span class="section-label">About</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <div class="md:col-span-2 card p-8">
        <h3 class="text-xl font-bold mb-4 text-text-primary">Hi, I'm Ajvad</h3>
        <p class="text-lg text-text-tertiary leading-relaxed">
          A cybersecurity analyst and bug bounty hunter from Malappuram, Kerala. I hunt vulnerabilities across Indian government and private sector platforms, building security tools to automate reconnaissance and red team operations.
        </p>
        <div class="mt-6 flex items-center gap-4">
          <img src="/images/profile.jpg" alt="Profile" class="w-12 h-12 rounded-full object-cover" style="border: 1px solid rgba(255,255,255,0.08); filter: grayscale(40%) contrast(110%) brightness(105%);" />
          <div>
            <p class="text-sm text-text-primary font-bold">Active on</p>
            <p class="text-sm text-text-tertiary">NCIIPC &middot; Max Healthcare &middot; Nykaa &middot; Maruti Suzuki</p>
          </div>
        </div>
      </div>

      <div class="card p-6">
        <span class="text-base text-text-quaternary">Experience</span>
        <div class="mt-4">
          <h4 class="text-lg font-bold text-text-primary">{experience[0].role}</h4>
          <p class="text-base text-accent mt-0.5">{experience[0].company}</p>
          <p class="text-base text-text-quaternary mt-1">{experience[0].period}</p>
          <p class="text-base text-text-tertiary mt-3 leading-relaxed">{experience[0].desc}</p>
        </div>
      </div>

      <div class="md:col-span-3 card p-6">
        <span class="text-base text-text-quaternary">Core Skills</span>
        <div class="mt-4 space-y-4">
          {skillGroups.map(group => (
            <div>
              <p class="text-xs text-text-quaternary mb-2">{group.label}</p>
              <div class="flex flex-wrap gap-2">
                {group.items.map(skill => <Badge text={skill} />)}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
