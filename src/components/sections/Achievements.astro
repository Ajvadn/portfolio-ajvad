---
const achievements = [
  {
    title: "NCIIPC Acknowledgment",
    organization: "National Critical Information Infrastructure Protection Centre",
    date: "2025",
    description: "Reported and acknowledged for 2 vulnerabilities in Indian Government websites."
  },
  {
    title: "Hall of Fame",
    organization: "Max Healthcare",
    date: "2026",
    description: "Recognized in the Max Healthcare Hall of Fame for identifying and reporting security vulnerabilities.",
    imageUrl: "/images/max-hc-hof.jpg"
  },
  {
    title: "Hall of Fame",
    organization: "Nykaa",
    date: "2026",
    description: "Acknowledged in the Nykaa Hall of Fame for responsible disclosure of security flaws.",
    imageUrl: "/images/nykaa-hof.jpg"
  },
  {
    title: "Bug Bounty Reward (₹5,000)",
    organization: "Nykaa",
    date: "2026",
    description: "Awarded a bug bounty of ₹5,000 for discovering and responsibly disclosing a security vulnerability.",
    imageUrl: "/images/nykaa-bounty.png"
  },
  {
    title: "Hall of Fame & Bounty",
    organization: "Maruti Suzuki",
    date: "2026",
    description: "Recognized in the Maruti Suzuki Hall of Fame and awarded ₹1,000 for responsibly disclosing a security vulnerability.",
    imageUrl: "/images/hall-of-fame-on-maruthi-suzuki.png"
  }
];
---

<section id="achievements" class="py-24 px-6 reveal">
  <div class="max-w-6xl mx-auto">
    <div class="flex items-center gap-3 mb-16">
      <span class="section-label">Achievements</span>
    </div>

    <div class="space-y-2 reveal-stagger">
      {achievements.map((item, i) => (
        <div class="card-hover p-5 group flex items-start gap-5">
          <div class="flex flex-col items-center gap-1 shrink-0 pt-0.5">
            <div class="w-2 h-2 rounded-full" class:list={["bg-accent", {"opacity-40": i === 0}]}></div>
            {i < achievements.length - 1 && <div class="w-px flex-1" style="background: rgba(255,255,255,0.06); min-height: 1rem;"></div>}
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h3 class="text-lg font-bold text-text-primary group-hover:text-accent transition-colors">{item.title}</h3>
                <p class="text-base text-text-tertiary mt-0.5">{item.organization}</p>
              </div>
              <span class="text-base text-text-quaternary whitespace-nowrap shrink-0">{item.date}</span>
            </div>
            <p class="text-base text-text-tertiary leading-relaxed mt-2">{item.description}</p>
          </div>
          {item.imageUrl && (
            <div class="w-28 h-20 rounded-md overflow-hidden shrink-0 cursor-pointer self-start mt-1" style="border: 1px solid rgba(255,255,255,0.06);">
              <img
                src={item.imageUrl}
                alt={`${item.title} - ${item.organization}`}
                class="w-full h-full object-cover lightbox-btn"
              />
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
