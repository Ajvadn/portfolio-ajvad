---
const certifications = [
  {
    title: "Certified Ethical Hacker (CEH)",
    issuer: "EC-Council",
    date: "2025",
    image: "/images/ceh-cert.png",
    description: "Mastered the latest ethical hacking tools and techniques to identify vulnerabilities and secure systems."
  },
  {
    title: "Google Cybersecurity Certificate",
    issuer: "Google",
    date: "2025",
    image: "/images/google-cybersecurity.jpg",
    description: "Gained hands-on experience with Python, Linux, SQL, and SIEM tools for cybersecurity analysis."
  }
];
---

<section id="certifications" class="py-24 px-6 reveal">
  <div class="max-w-6xl mx-auto">
    <div class="flex items-center gap-3 mb-16">
      <span class="section-label">Certifications</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 reveal-stagger">
      {certifications.map((cert) => (
        <div class="card-hover overflow-hidden group">
          <div class="aspect-[4/3] overflow-hidden" style="background: #050505;">
            <img
              src={cert.image}
              alt={cert.title}
              class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500 lightbox-btn"
            />
          </div>
          <div class="p-5">
            <div class="flex items-start justify-between mb-2">
              <div>
                <h3 class="text-lg font-bold text-text-primary group-hover:text-accent transition-colors">
                  {cert.title}
                </h3>
                <p class="text-base text-text-tertiary mt-0.5">{cert.issuer}</p>
              </div>
              <span class="text-base text-text-quaternary whitespace-nowrap ml-4">{cert.date}</span>
            </div>
            <p class="text-base text-text-tertiary leading-relaxed">{cert.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
