---
import { Github, Linkedin, Instagram } from 'lucide-react';
---

<section id="contact" class="py-24 px-6 reveal">
  <div class="max-w-6xl mx-auto">
    <div class="max-w-xl mx-auto text-center">
      <div class="flex items-center justify-center gap-3 mb-8">
        <span class="section-label">Contact</span>
      </div>

      <h2 class="text-4xl md:text-5xl font-bold tracking-[-0.704px] mb-6 text-text-primary">
        Get in <span class="gradient-text">Touch</span>
      </h2>

      <p class="text-lg text-text-tertiary mb-10 leading-relaxed">
        Have a security concern or want to collaborate? Let's talk.
      </p>

      <a
        href="mailto:&#97;&#106;&#118;&#97;&#100;&#97;&#106;&#117;&#50;&#48;&#48;&#51;&#64;&#103;&#109;&#97;&#105;&#108;&#46;&#99;&#111;&#109;"
        class="btn btn-primary mb-12 inline-flex"
      >
        Send an Email
      </a>

      <div class="flex justify-center gap-3 mt-12">
        <a
          href="https://github.com/Ajvadn"
          target="_blank"
          rel="noopener noreferrer"
          class="card-hover p-3"
          aria-label="GitHub"
        >
          <Github size={22} />
        </a>
        <a
          href="https://www.linkedin.com/in/ajvad-n/"
          target="_blank"
          rel="noopener noreferrer"
          class="card-hover p-3"
          aria-label="LinkedIn"
        >
          <Linkedin size={22} />
        </a>
        <a
          href="https://instagram.com/ajvad______"
          target="_blank"
          rel="noopener noreferrer"
          class="card-hover p-3"
          aria-label="Instagram"
        >
          <Instagram size={22} />
        </a>
      </div>
    </div>

    <footer class="mt-24 text-center">
      <p class="text-base text-text-quaternary">&copy; {new Date().getFullYear()} AJVAD N.</p>
    </footer>
  </div>
</section>
