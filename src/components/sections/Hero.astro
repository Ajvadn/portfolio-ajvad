---
---

<section id="home" class="min-h-screen flex flex-col justify-center relative px-6 pt-20 overflow-hidden">
  <div class="max-w-6xl mx-auto w-full">
    <div class="flex flex-col md:flex-row items-center gap-12 md:gap-20">
      <div class="flex-1 max-w-3xl">
        <div class="flex items-center gap-2 mb-6 reveal" style="transition-delay: 0s;">
          <span class="w-1.5 h-1.5 rounded-full bg-success"></span>
          <span class="text-lg text-text-quaternary font-mono">Cybersecurity Analyst</span>
        </div>

        <h1 class="text-6xl md:text-7xl lg:text-8xl font-bold tracking-[-1.056px] leading-[1.05] mb-6 text-text-primary reveal" style="transition-delay: 0.1s;">
          AJVAD N.
        </h1>

        <p class="text-2xl md:text-3xl text-text-tertiary leading-relaxed max-w-xl mb-10 reveal" style="transition-delay: 0.2s;">
          Bug bounty hunter with findings across Indian govt &amp; private platforms. Building tools for recon and red teaming.
        </p>

        <div class="flex flex-wrap gap-3 reveal" style="transition-delay: 0.3s;">
          <a href="#projects" class="btn btn-primary">
            <span>View Projects</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          <a href="#contact" class="btn btn-ghost">
            Get in Touch
          </a>
        </div>

        <div class="flex gap-8 mt-12 pt-8 reveal" style="transition-delay: 0.4s;">
          <div class="card p-4 flex items-center gap-3 min-w-0">
            <span class="text-2xl font-bold text-accent shrink-0">5+</span>
            <div>
              <p class="text-xs text-text-quaternary">Platforms</p>
              <p class="text-xs text-text-tertiary">NCIIPC &middot; Max &middot; Nykaa &middot; Maruti</p>
            </div>
          </div>
          <div class="card p-4 flex items-center gap-3 min-w-0">
            <span class="text-2xl font-bold text-accent shrink-0">3</span>
            <div>
              <p class="text-xs text-text-quaternary">Hall of Fame</p>
              <p class="text-xs text-text-tertiary">Max &middot; Nykaa &middot; Maruti Suzuki</p>
            </div>
          </div>
          <div class="card p-4 flex items-center gap-3 min-w-0">
            <span class="text-2xl font-bold text-accent shrink-0">₹6K+</span>
            <div>
              <p class="text-xs text-text-quaternary">Bounties</p>
              <p class="text-xs text-text-tertiary">Nykaa &middot; Maruti Suzuki</p>
            </div>
          </div>
        </div>
      </div>

      <div class="shrink-0 reveal" style="transition-delay: 0.2s;">
        <div class="relative">
          <div class="absolute inset-0 rounded-full" style="background: radial-gradient(circle, rgba(92,92,255,0.2) 0%, transparent 70%); transform: scale(1.15);"></div>
          <div class="w-48 h-48 md:w-64 md:h-64 rounded-full overflow-hidden ring-1" style="border: 1px solid rgba(92,92,255,0.15);">
            <img src="/images/profile.jpg" alt="AJVAD N." class="w-full h-full object-cover" style="filter: grayscale(40%) contrast(110%) brightness(105%);" />
            <div class="absolute inset-0 rounded-full mix-blend-overlay pointer-events-none" style="background: linear-gradient(135deg, rgba(92,92,255,0.1), transparent 60%);"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="fixed top-1/3 right-0 w-[800px] h-[800px] rounded-full pointer-events-none -z-10" style="background: radial-gradient(circle, rgba(92,92,255,0.04) 0%, transparent 70%); animation: pulse-glow 4s ease-in-out infinite;"></div>
  </div>
</section>
