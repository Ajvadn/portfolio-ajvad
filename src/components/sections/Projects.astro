---
import { Github, ExternalLink } from 'lucide-react';

const projects = [
  {
    title: "Subdomain Hunter",
    description: "Automated subdomain enumeration tool for discovering hidden assets and expanding attack surfaces during reconnaissance.",
    technologies: ["Bash", "Bug Bounty", "Recon"],
    githubUrl: "https://github.com/Ajvadn/subdomain-hunter.git"
  },
  {
    title: "parm-fuzzer",
    description: "Efficient URL gathering tool to collect and organize URLs from various sources for comprehensive reconnaissance.",
    technologies: ["Go", "Recon", "Fuzzing"],
    githubUrl: "https://github.com/Ajvadn/parm-fuzzer.git"
  },
  {
    title: "Drooper",
    description: "Advanced social engineering tool for penetration testing to generate and deliver payloads via various attack vectors.",
    technologies: ["Python", "Social Engineering", "Red Teaming"],
    githubUrl: "https://github.com/Ajvadn/Drooper"
  },
  {
    title: "Deauther & Evil Twin",
    description: "Wi-Fi deauthentication and Evil Twin simulation tool using ESP32/ESP8266 for wireless security research.",
    technologies: ["WiFi Pentesting", "IoT", "ESP32/ESP8266"],
    githubUrl: "https://github.com/Ajvadn",
    linkedinUrl: "https://www.linkedin.com/posts/ajvad-n_cybersecurity-wifisecurity-ethicalhacking-activity-7264682031689719809-0jvu"
  },
  {
    title: "HID Attacks (ATtiny85)",
    description: "Firmware for ATtiny85 to emulate USB HID devices for controlled security testing and keystroke injection.",
    technologies: ["Ethical Hacking", "IoT", "Embedded Systems"],
    githubUrl: "https://github.com/Ajvadn"
  },
  {
    title: "VOICEGPT",
    description: "Research on ChatGPT's role in improving communicative competence and the future of AI in education.",
    technologies: ["AI/ML", "Python"],
    githubUrl: "https://github.com/Ajvadn"
  }
];
---

<section id="projects" class="py-24 px-6 reveal">
  <div class="max-w-6xl mx-auto">
    <div class="flex items-center gap-3 mb-16">
      <span class="section-label">Projects</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 reveal-stagger">
      {projects.map((project) => (
        <div class="card-hover p-5 flex flex-col group">
          <div class="flex-1">
            <h3 class="text-lg font-bold text-text-primary group-hover:text-accent transition-colors mb-2">
              {project.title}
            </h3>
            <p class="text-base text-text-tertiary leading-relaxed mb-4">
              {project.description}
            </p>
          </div>
          <div class="flex items-center justify-between">
            <div class="flex flex-wrap gap-1.5">
              {project.technologies.map(tag => (
                <span class="tag text-xs">{tag}</span>
              ))}
            </div>
            <div class="flex gap-2 shrink-0 ml-4">
              {project.githubUrl && (
                <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="text-text-tertiary hover:text-accent transition-colors">
                  <Github size={18} />
                </a>
              )}
              {project.linkedinUrl && (
                <a href={project.linkedinUrl} target="_blank" rel="noopener noreferrer" class="text-text-tertiary hover:text-accent transition-colors">
                  <ExternalLink size={18} />
                </a>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
